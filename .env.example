# PostgreSQL connection settings for the NovMart database
# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — it should be listed in .gitignore.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=novmart_raw
DB_USER=your_username
DB_PASSWORD=your_password

# Optional: schema to load raw CSVs into
DB_SCHEMA=raw
